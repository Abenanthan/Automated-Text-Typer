{
  "manifest_version": 3,
  "name": "Code Writer Practice - Universal Editor",
  "version": "0.5.1",
  "description": "Universal editor adapter for the local practice IDE.",
  "permissions": [
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}