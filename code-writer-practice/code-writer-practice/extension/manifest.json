{
  "manifest_version": 3,
  "name": "Code Writer Practice",
  "version": "0.1.0",
  "description": "Writes supplied code into the local Code Writer Practice IDE.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}