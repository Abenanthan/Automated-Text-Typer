{
  "manifest_version": 3,
  "name": "Code Writer Practice - Project Writer",
  "version": "0.3.0",
  "description": "Writes an entire local project into the Phase 3 Monaco practice IDE.",
  "permissions": [
    "storage",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}